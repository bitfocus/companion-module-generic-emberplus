{
	"name": "generic-emberplus",
	"version": "3.0.0-1",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "yarn build:watch",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"dist": "yarn companion-module-build",
		"package": "run build && companion-module-build",
		"format": "prettier -w .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc -p tsconfig.json --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-generic-emberplus.git"
	},
	"license": "MIT",
	"lint-staged": {
		"*.{js,json,md}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^26.13"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.2",
		"@phillipivan/emberplus-connection": "~0.5.2",
		"es-toolkit": "^1.53.2",
		"p-queue": "^10.0.0"
	},
	"devDependencies": {
		"@companion-app/expressions": "1.1.1",
		"@companion-module/tools": "^3.2.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.1",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "5.1.1"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
